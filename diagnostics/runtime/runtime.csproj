<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefineConstants>PROTON</DefineConstants>
    <SourceRoot Condition="'$(SourceRoot)' == ''">$(MSBuildProjectDirectory)/.source</SourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(SourceRoot)/src/plugin/Services/AutoUpdaterService.cs" Link="AutoUpdaterService.cs" />
    <Compile Include="$(SourceRoot)/src/plugin/Patches/MyInputManager.cs" Link="MyInputManager.cs" />
    <Compile Include=".generated/ExtractedReset.cs" />
    <PackageReference Include="LiteNetLib" Version="1.3.5" />
  </ItemGroup>
</Project>
