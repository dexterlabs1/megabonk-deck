using System;
using System.Collections;
using System.Collections.Generic;

public static class Program
{
    static int failures;
    static void Check(string name, Action test)
    {
        try { test(); Console.WriteLine("PASS " + name); }
        catch (Exception ex) { failures++; Console.WriteLine("FAIL " + name + ": " + ex.GetType().Name + ": " + ex.Message); }
    }
    static void Assert(bool ok, string message) { if (!ok) throw new Exception(message); }
    public static int Main()
    {
        Check("random connection timeout returns to UI without throwing", () => {
            Plugin.Instance.NetworkHandler = new NetworkHandler();
            var modal = new NetworkMenuTab();
            var coroutine = modal.RandomRoutine();
            for (int i = 0; i < 100 && coroutine.MoveNext(); i++) { }
        });
        Check("friendlies connection timeout returns to UI without throwing", () => {
            Plugin.Instance.NetworkHandler = new NetworkHandler();
            var modal = new NetworkMenuTab();
            var coroutine = modal.FriendliesRoutine();
            for (int i = 0; i < 100 && coroutine.MoveNext(); i++) { }
        });
        Check("B after failed friendlies connection shows only root menu", () => {
            Plugin.Instance.NetworkHandler = new NetworkHandler { IsConnectedToMatchMaker = false };
            var modal = new NetworkMenuTab();
            modal.SimulateConnectionStarted();
            var coroutine = modal.FriendliesRoutine();
            for (int i = 0; i < 100 && coroutine.MoveNext(); i++) { }
            Assert(modal.FriendliesVisible && !modal.RootVisible, "Setup failed: failure did not return to friendlies");
            modal.ControllerBack();
            Assert(modal.RootVisible && !modal.FriendliesVisible, "Root and Friendlies are BOTH visible; stale coroutine took OnStopClicked branch");
        });
        Check("closing changelog restores enabled main-menu buttons", () => {
            var play = new MyButton(); var together = new MyButton();
            WindowManager.activeWindow = new Window { allButtons = new() { play, together } };
            ChangelogModal.Show(new List<VersionChanges>());
            Assert(!play.Enabled && !together.Enabled, "Setup failed: changelog did not disable original buttons");
            var controls = new DeckMenuControls();
            // Models the capture/replacement in DeckMenuControls.Tick lines 90/110.
            controls.AcquireAndReplace(WindowManager.activeWindow, new() { new MyButton() });
            ChangelogModal.Last.NavigationOwner = controls;
            ChangelogModal.Last.Close();
            Assert(play.Enabled && together.Enabled, "Restored main-menu buttons remain DISABLED");
        });
        Console.WriteLine($"Result: {failures}/4 regression assertions failed; production method bodies, stubbed runtime.");
        return failures == 0 ? 0 : 1;
    }
}

public class NetworkMenuTab : ModalBase
{
    CustomButton stopButton = new(), randomButton = new(), friendliesButton = new(), netplayOptionsButton = new(), closeButton = new();
    CustomButton hostButton = new(), joinButton = new(), friendliesBackButton = new(), netplayOptionsBackButton = new(), pasteButton = new();
    Field playerNameInput = new(), codeInput = new();
    GameObject label = new(), friendliesTitle = new(), codeLabel = new(), netplayOptionsTitle = new(), saveToggleSetting = new(), sharedExpToggleSetting = new();
    MainMenu mainMenu = new(); Coroutine connectionCoroutine;
    public NetworkMenuTab() { UpdateModalContents(false); UpdateFriendliesUI(false); UpdateNetplayOptionsUI(false); stopButton.gameObject.SetActive(false); }
    public IEnumerator RandomRoutine() => HandleConnectionStatus();
    public IEnumerator FriendliesRoutine() => HandleFriendlies();
    public void SimulateConnectionStarted() { connectionCoroutine = new Coroutine(); }
    public bool RootVisible => randomButton.gameObject.activeInHierarchy;
    public bool FriendliesVisible => hostButton.gameObject.activeInHierarchy;
    void OnFriendliesBackClicked() { UpdateFriendliesUI(false); UpdateModalContents(true); }
    void OnNetplayOptionsBackClicked() { UpdateNetplayOptionsUI(false); UpdateModalContents(true); }
    void OnCloseClicked() { CloseModal(); }
    /*NETWORK_METHODS*/
}

