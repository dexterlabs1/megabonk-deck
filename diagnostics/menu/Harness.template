public class DeckMenuControls
{
    Window owner; List<MyButton> savedButtons; HashSet<GameObject> savedButtonSet; MyButton savedSelection; ModalBase currentModal;
    public void AcquireAndReplace(Window window, List<MyButton> modalButtons)
    {
        owner = window; savedButtons = window.allButtons; savedButtonSet = window.allButtonsHashed; savedSelection = ButtonManager.selectedButton2;
        window.allButtons = modalButtons;
    }
    public void Release() { RestoreWindow(); }
    /*RESTORE_METHOD*/
}

